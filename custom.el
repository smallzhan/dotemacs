(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(Info-quoted ((t (:inherit fixed-pitch))))
 '(org-block ((t (:inherit fixed-pitch))))
 '(org-checkbox ((t :inherit 'fixed-pitch :box nil)))
 '(org-code ((t (:inherit (shadow fixed-pitch)))))
 '(org-document-info-keyword ((t (:inherit (shadow fixed-pitch)))))
 '(org-drawer ((t :inherit 'fixed-pitch)))
 '(org-indent ((t (:inherit (org-hide fixed-pitch)))))
 '(org-latex-and-related ((t (:inherit 'fixed-pitch-serif))))
 '(org-level-1 ((t :inherit 'outline-1 :height 1.1)))
 '(org-level-2 ((t :inherit 'outline-2 :height 1.05)))
 '(org-meta-line ((t (:inherit (font-lock-comment-face fixed-pitch)))))
 '(org-property-value ((t (:inherit fixed-pitch))))
 '(org-special-keyword ((t (:inherit (font-lock-comment-face fixed-pitch)))))
 '(org-table ((t (:inherit fixed-pitch))))
 '(org-tag ((t (:inherit (shadow fixed-pitch-serif) :weight bold :height 1.0))))
 '(org-verbatim ((t (:inherit (shadow fixed-pitch)))))
 '(pulse-highlight-face ((t (:inherit region))) t)
 '(pulse-highlight-start-face ((t (:inherit region))) t)
 '(rime-preedit-face ((t (:underline t)))))
 
